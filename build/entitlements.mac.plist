<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Ad-hoc signing plus the hardened runtime makes macOS enforce library
    validation, which refuses to load Electron's own frameworks because they
    carry a different (also ad-hoc) signature. Without this the app builds
    cleanly and then fails to launch. electron-builder warns about exactly this.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Electron's JIT needs both of these under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
